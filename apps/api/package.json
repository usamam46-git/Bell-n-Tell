{
  "name": "@bellntell/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=../../.env --import tsx --watch src/server.ts",
    "start": "node --env-file=../../.env dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "node --env-file=../../.env ../../node_modules/vitest/vitest.mjs run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=../../.env --import tsx src/db/migrate.ts",
    "db:seed": "node --env-file=../../.env --import tsx src/db/seed.ts"
  },
  "dependencies": {
    "@bellntell/contracts": "0.1.0",
    "@fastify/cookie": "^11.0.0",
    "argon2": "^0.44.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.0.0",
    "pg": "^8.0.0",
    "ws": "^8.22.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.0.0",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.5"
  }
}
